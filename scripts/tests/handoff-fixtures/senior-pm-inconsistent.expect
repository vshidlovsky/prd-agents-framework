# and each count must match the tickets of that type
dispositionCounts.fixTechnical: fixTechnical (3) != 1 ticket(s) of type "technical"
dispositionCounts.fixProduct: fixProduct (0) != 1 ticket(s) of type "product"

# reject must equal the rejectedFails array length
dispositionCounts.reject: reject (5) != 1 entr

# escalate must equal the escalations array length
dispositionCounts.escalate: escalate (0) != 1 entr

# tickets exist, so the writer is next
nextAgent: 2 ticket(s) require nextAgent "prd-writer", got "none"
